#!/usr/bin/env bash
# =============================================================================
#  davinci-kit-info — Show DaVinci Resolve system diagnostics and tips
#
#  Checks GPU, OpenCL, codecs, disk space, font paths, library versions,
#  and configuration — everything relevant to running Resolve on Linux.
# =============================================================================

set -euo pipefail

if [[ -t 1 ]]; then
  GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'
  RED='\033[0;31m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'
else
  GREEN=''; YELLOW=''; CYAN=''; RED=''; BOLD=''; DIM=''; RESET=''
fi

section() { echo -e "\n${BOLD}${CYAN}━━━ $* ━━━${RESET}"; }
ok()         { echo -e "  ${GREEN}[OK]${RESET} $*"; }
blocker()    { echo -e "  ${RED}[BLOCKER]${RESET} $*"; BLOCKERS=$((BLOCKERS + 1)); }
workaround() { echo -e "  ${YELLOW}[WORKAROUND]${RESET} $*"; WORKAROUNDS=$((WORKAROUNDS + 1)); }
optional()   { echo -e "  ${CYAN}[OPTIONAL]${RESET} $*"; OPTIONALS=$((OPTIONALS + 1)); }
info()       { echo -e "  ${DIM}[INFO]${RESET} $*"; }

BLOCKERS=0
WORKAROUNDS=0
OPTIONALS=0

echo -e "\n${BOLD}═══ DaVinci Resolve System Diagnostics ═══${RESET}"

# ── Resolve Installation ──────────────────────────────────────────────────────
section "Installation"

if [[ -d /opt/resolve ]]; then
  ok "Resolve installed at /opt/resolve"
  # Detect version and edition
  if [[ -f /opt/resolve/bin/resolve ]]; then
    ver_string=$(strings /opt/resolve/bin/resolve 2>/dev/null | grep -oP '\d+\.\d+\.\d+\.\d+_lite' | head -1 || true)
    if [[ -n "$ver_string" ]]; then
      info "Version: ${ver_string/_lite/} (FREE/Lite)"
    else
      ver_string=$(strings /opt/resolve/bin/resolve 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1 || echo "unknown")
      info "Version: ${ver_string} (edition unknown)"
    fi
  fi
  # Check for Studio license
  if [[ -f /opt/resolve/.license/blackmagic.lic ]] || ls /opt/resolve/.license/* 2>/dev/null | grep -q .; then
    ok "Studio license detected (plugins available)"
  else
    optional "No Studio license found — IOEncoder plugins will NOT work"
    info "  IOEncoder plugins (H.264/H.265/AAC) require DaVinci Resolve Studio"
    info "  Codec support on Linux (Free version):"
    info "    H.264/H.265 decode: Studio only"
    info "    H.264/H.265 encode: Studio only"
    info "    AV1 decode: FREE (GPU-accelerated with NVIDIA) ✅"
    info "    AV1 encode: Studio + NVIDIA GPU (RTX 40-series+ for NVENC AV1)"
    info "    AAC audio: Not supported on ANY Linux version (Free or Studio)"
    info "    DNxHR/ProRes: Full support in Free version ✅"
  fi
  # Check if IOPlugins directory exists
  if [[ -d /opt/resolve/IOPlugins ]] && ls /opt/resolve/IOPlugins/*.dvcp.bundle 2>/dev/null | grep -q .; then
    ok "IOPlugins installed: $(ls /opt/resolve/IOPlugins/*.dvcp.bundle 2>/dev/null | xargs -n1 basename | tr '\n' ' ')"
  else
    optional "No IOEncoder plugins installed (requires Studio)"
  fi

  # Check package installation style (Arch specific AUR check)
  if command -v pacman &>/dev/null; then
    if pacman -Q davinci-resolve &>/dev/null; then
      ok "AUR package: $(pacman -Q davinci-resolve)"
    elif pacman -Q davinci-resolve-studio &>/dev/null; then
      ok "AUR package (Studio): $(pacman -Q davinci-resolve-studio)"
    else
      info "Not installed via AUR (manual install)"
    fi
  fi
else
  blocker "Resolve not found at /opt/resolve"
fi

# ── GPU & OpenCL ─────────────────────────────────────────────────────────────
section "GPU & OpenCL"

GPU_VENDOR=""
if command -v nvidia-smi &>/dev/null && nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | grep -q .; then
  GPU_VENDOR="nvidia"
  gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
  gpu_mem=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader 2>/dev/null | head -1)
  gpu_driver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)
  ok "NVIDIA GPU: ${gpu_name:-unknown}, ${gpu_mem:-?} VRAM"
  info "Driver: ${gpu_driver:-unknown}"
elif command -v lspci &>/dev/null; then
  gpu_line=$(lspci 2>/dev/null | grep -iE 'vga|3d|display' | head -1)
  if echo "$gpu_line" | grep -qi 'amd'; then
    GPU_VENDOR="amd"
    ok "AMD GPU detected: $gpu_line"
  elif echo "$gpu_line" | grep -qi 'intel'; then
    GPU_VENDOR="intel"
    ok "Intel GPU detected: $gpu_line"
  else
    info "GPU detected: $gpu_line"
  fi
else
  info "No GPU detection method available (nvidia-smi and lspci not found)"
fi

if command -v clinfo &>/dev/null; then
  platforms=$(clinfo -l 2>/dev/null)
  if [[ -n "$platforms" ]]; then
    ok "OpenCL platforms detected:"
    echo "$platforms" | while read -r line; do
      info "$line"
    done
  else
    blocker "No OpenCL platforms found"
  fi
else
  optional "clinfo not installed — cannot verify OpenCL. Install clinfo to verify."
fi

# Check OpenCL ICDs
if [[ -d /etc/OpenCL/vendors ]]; then
  info "OpenCL ICDs: $(ls /etc/OpenCL/vendors/ 2>/dev/null | tr '\n' ' ')"
fi

# ── PRIME / Hybrid GPU ───────────────────────────────────────────────────────
section "GPU Offload (PRIME)"

# Detect device vendors
has_nvidia_dgpu=0
has_amd_dgpu=0
for vendor_file in /sys/class/drm/card*/device/vendor; do
  if [[ -f "$vendor_file" ]]; then
    vid=$(cat "$vendor_file" 2>/dev/null)
    if [[ "$vid" == "0x10de" ]]; then
      has_nvidia_dgpu=1
    elif [[ "$vid" == "0x1002" ]]; then
      has_amd_dgpu=1
    fi
  fi
done

card_count=$(ls /dev/dri/card* 2>/dev/null | wc -l)
has_hybrid=0
if [[ $card_count -ge 2 ]]; then
  has_hybrid=1
fi

if command -v envycontrol &>/dev/null; then
  info "Current GPU mode: $(envycontrol --query 2>/dev/null || echo 'unknown')"
fi

resolve_fix_exists=0
if [[ -f "$HOME/.local/bin/davinci-kit-fix" ]] || [[ -L "$HOME/.local/bin/davinci-kit-fix" ]] || [[ -f "/usr/bin/davinci-kit-fix" ]]; then
  resolve_fix_exists=1
  ok "davinci-kit-fix launcher exists"
else
  if [[ $has_hybrid -eq 1 ]]; then
    workaround "davinci-kit-fix launcher not found (needed on hybrid GPU setups to offload to PRIME)"
  else
    optional "davinci-kit-fix launcher not found (optional workaround helper)"
  fi
fi

if [[ -f "$HOME/.local/share/applications/com.blackmagicdesign.resolve.desktop" ]]; then
  ok "Desktop file override exists"
else
  if [[ $has_hybrid -eq 1 ]]; then
    workaround "No custom desktop file — Resolve may use wrong GPU on hybrid systems"
  else
    optional "No custom desktop file override (optional)"
  fi
fi

# ── Library Mismatch ──────────────────────────────────────────────────────────
section "Library Compatibility"

detect_lib_dir() {
    for dir in /usr/lib/x86_64-linux-gnu /usr/lib64 /usr/lib; do
        if [[ -f "$dir/libglib-2.0.so.0" ]]; then
            echo "$dir"
            return
        fi
    done
    echo "/usr/lib"
}
LIBDIR="$(detect_lib_dir)"

# Compare two version strings numerically (e.g. 2.88.0 > 2.80.0)
version_gt() {
  # Returns 0 (true) if $1 > $2 numerically by component
  local IFS=.
  read -ra a <<< "$1"
  read -ra b <<< "$2"
  for i in "${!a[@]}"; do
    local av="${a[$i]:-0}" bv="${b[$i]:-0}"
    if (( av > bv )); then return 0; fi
    if (( av < bv )); then return 1; fi
  done
  return 1
}

glib_mismatch=0
for lib in libglib-2.0.so.0 libgio-2.0.so.0 libgmodule-2.0.so.0 libgobject-2.0.so.0; do
  sys_ver=$(readlink "$LIBDIR/$lib" 2>/dev/null || echo "missing")
  res_ver=$(readlink /opt/resolve/libs/$lib 2>/dev/null || echo "missing")
  if [[ "$sys_ver" != "missing" ]] && [[ "$res_ver" != "missing" ]]; then
    sys_num=$(echo "$sys_ver" | grep -oP '\d+\.\d+\.\d+' | head -1)
    res_num=$(echo "$res_ver" | grep -oP '\d+\.\d+\.\d+' | head -1)
    if version_gt "$sys_num" "$res_num"; then
      glib_mismatch=1
      info "$lib: system=$sys_ver > bundled=$res_ver (mismatch)"
    fi
  fi
done

if [[ $glib_mismatch -eq 1 ]]; then
  if [[ $resolve_fix_exists -eq 1 ]]; then
    workaround "GLib version mismatch detected but davinci-kit-fix workaround is active."
  else
    workaround "GLib version mismatch detected. davinci-kit-fix workaround is needed to prevent crashes."
  fi
else
  ok "No GLib library mismatches found."
fi

# ── Codecs ────────────────────────────────────────────────────────────────────
section "FFmpeg Codecs"

if command -v ffmpeg &>/dev/null; then
  ok "ffmpeg: $(ffmpeg -hide_banner -version 2>/dev/null | head -1 || echo 'installed')"

  encoders=$(ffmpeg -hide_banner -encoders 2>/dev/null || true)

  # Check standard software encoders
  for codec in "dnxhd" "libx264" "libx265" "libsvtav1" "aac" "pcm_s24le" "alac" "libvpx-vp9" "libopus" "flac"; do
    if echo "$encoders" | grep -qE "[[:space:]]+${codec}[[:space:]]+"; then
      ok "Encoder available: $codec"
    else
      optional "Encoder missing: $codec"
    fi
  done

  # Check hardware encoders (only print if available)
  for codec in h264_nvenc hevc_nvenc av1_nvenc h264_amf hevc_amf av1_amf h264_qsv hevc_qsv av1_qsv h264_vaapi hevc_vaapi av1_vaapi; do
    if echo "$encoders" | grep -qE "[[:space:]]+${codec}[[:space:]]+"; then
      ok "HW encoder available: $codec"
    fi
  done

  # Check key decoders
  decoders=$(ffmpeg -hide_banner -decoders 2>/dev/null || true)
  for codec in "h264" "hevc" "dnxhd" "av1" "vp9" "vp8" "opus" "aac" "flac" "alac" "pcm_s16le" "theora" "wmv" "mpeg2video" "mpeg4" "dvvideo"; do
    if echo "$decoders" | grep -qE "[[:space:]]+${codec}[[:space:]]+"; then
      :
    else
      if [[ "$codec" == "wmv" ]]; then
        optional "Decoder missing: wmv (only needed if importing WMV files)"
      else
        optional "Decoder missing: $codec"
      fi
    fi
  done
else
  blocker "ffmpeg not found!"
fi

# ── Disk Space ────────────────────────────────────────────────────────────────
section "Disk Space"

free_space_kb=$(df -k "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
if [[ -n "$free_space_kb" ]]; then
  free_gb=$((free_space_kb / 1024 / 1024))
  if [[ $free_gb -gt 20 ]]; then
    ok "Storage space: ${free_gb} GB free"
  elif [[ $free_gb -gt 5 ]]; then
    workaround "Storage space low: ${free_gb} GB free"
  else
    blocker "Storage space critical: ${free_gb} GB free"
  fi
else
  info "Could not determine free disk space"
fi

# ── Font Configuration ────────────────────────────────────────────────────────
section "Font Configuration"

fontconfig_found=0
sys_fonts_dir="/usr/share/fonts"
user_fonts_dir="$HOME/.local/share/fonts"
user_fonts_deprecated="$HOME/.fonts"

# Check standard system font configs
if [[ -d "/etc/fonts" ]]; then
  ok "Fontconfig installed"
  fontconfig_found=1
fi

if [[ -d "$sys_fonts_dir" ]]; then
  ok "System fonts path exists: $sys_fonts_dir"
fi

if [[ -d "$user_fonts_dir" ]]; then
  ok "User local fonts path exists: $user_fonts_dir"
else
  optional "User fonts directory not found (~/.local/share/fonts)"
  info "  Create this folder to install custom fonts"
fi

if [[ -d "$user_fonts_deprecated" ]]; then
  info "Deprecated user fonts folder exists: ~/.fonts (legacy support)"
fi

# ── Resolve Toolkit ──────────────────────────────────────────────────────────
section "Resolve Toolkit"

ok "davinci-kit-transcode CLI binary: $(command -v davinci-kit-transcode || echo 'not in PATH')"
ok "davinci-kit-export CLI binary: $(command -v davinci-kit-export || echo 'not in PATH')"
ok "davinci-kit-watch CLI binary: $(command -v davinci-kit-watch || echo 'not in PATH')"

# ── Quick Reference ──────────────────────────────────────────────────────────
section "Quick Reference"

echo -e "  ${BOLD}Transcode raw video for editing:${RESET}"
echo    "    davinci-kit-transcode /path/to/raw                  # DNxHR SQ standard profile"
echo    "    davinci-kit-transcode -c av1 /path/to/raw           # AV1 compression profile"
echo    "    davinci-kit-transcode -q hqx -j 4 /path/to/raw      # DNxHR 12-bit, 4 parallel"
echo
echo -e "  ${BOLD}Export from Resolve for delivery:${RESET}"
echo    "    davinci-kit-export -p youtube export.mov             # YouTube H.264"
echo    "    davinci-kit-export -p h265 export.mov               # H.265 smaller file"
echo    "    davinci-kit-export -p nvenc export.mov              # NVENC GPU encode (fast)"
echo    "    davinci-kit-export -p av1 export.mov               # AV1 smallest file"
echo    "    davinci-kit-export -p archive export.mov           # Near-lossless"
echo    "    davinci-kit-export -p youtube -r 1080p big.mov      # Force 1080p output"
echo
echo -e "  ${BOLD}Auto-transcode watch folder:${RESET}"
echo    "    davinci-kit-watch ~/Downloads                       # Auto-convert new files"
echo    "    davinci-kit-watch -c av1 ~/Downloads               # Auto-convert to AV1"
echo
echo -e "  ${BOLD}Other tools:${RESET}"
echo    "    davinci-kit-fix          # Launch with library fix + GPU offload"
echo    "    davinci-kit-backup       # Backup/restore Resolve settings"
echo    "    davinci-kit-fonts        # Fix font paths in Fusion"
echo    "    davinci-kit-audio        # Convert audio files for Resolve"
echo    "    davinci-kit-info          # This diagnostics screen"

# ── Summary ──────────────────────────────────────────────────────────────────
echo
if [[ $BLOCKERS -eq 0 ]]; then
  if [[ $WORKAROUNDS -eq 0 ]]; then
    echo -e "${GREEN}${BOLD}Healthy: 0 blockers. Resolve appears usable.${RESET}"
  else
    echo -e "${YELLOW}${BOLD}Usable with workaround: 0 blockers, $WORKAROUNDS workaround(s).${RESET}"
  fi
else
  echo -e "${RED}${BOLD}Broken: $BLOCKERS blocker(s) need attention.${RESET}"
fi
echo
