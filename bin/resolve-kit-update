#!/usr/bin/env bash
set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$ROOT_DIR"

if [ ! -d ".git" ]; then
    echo "This install was not created from git. Reinstall with bootstrap.sh." >&2
    exit 1
fi

echo "Updating resolve-kit via git..."
git pull --ff-only
./install.sh
