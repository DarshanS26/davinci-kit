#!/usr/bin/env bash
# =============================================================================
#  davinci-kit-export — Convert DaVinci Resolve exports to delivery formats
#
#  Resolve exports DNxHR/ProRes .mov files. This script converts them to
#  compressed formats suitable for YouTube, social media, or archival.
#
#  Supports CPU encoding (libx264, libx265, SVT-AV1, VP9) and GPU encoding
#  (NVENC, AMF, QSV, VAAPI).
#
#  Usage:
#    davinci-kit-export [OPTIONS] <input.mov> [input2.mov ...]
#    davinci-kit-export [OPTIONS] <directory>
# =============================================================================

set -euo pipefail

PRESET="youtube"
OUTPUT_DIR=""
DRY_RUN=false
RESOLUTION=""
PARALLEL_JOBS=1
CUSTOM_VCODEC=""
CUSTOM_ACODEC=""
CRF_OVERRIDE=""
AUDIO_OVERRIDE=""  # overrides preset audio codec when set

if [[ -t 1 ]]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
  CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; RESET=''
fi

info()    { echo -e "${CYAN}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error()   { echo -e "${RED}[ERR]${RESET}   $*" >&2; }

usage() {
cat <<EOF
${BOLD}davinci-kit-export${RESET} — Convert Resolve exports to delivery formats

  ${BOLD}USAGE${RESET}
    $0 [OPTIONS] <input.mov> [input2.mov ...]
    $0 [OPTIONS] <directory>

  ${BOLD}PRESETS${RESET}
    youtube      H.264 1080p, CRF 18, AAC 192k         [DEFAULT]
    youtube4k    H.264 4K, CRF 20, AAC 192k
    h265         H.265 1080p, CRF 22, AAC 192k (smaller)
    h2654k       H.265 4K, CRF 24, AAC 192k
    nvenc        H.264 NVENC GPU encode, HQ, AAC 192k (NVIDIA)
    nvenc265     H.265 NVENC GPU encode, HQ, AAC 192k (NVIDIA)
    h264_amf     H.264 AMF GPU encode (AMD)
    hevc_amf     H.265 AMF GPU encode (AMD)
    h264_qsv     H.264 QSV GPU encode (Intel)
    hevc_qsv     H.265 QSV GPU encode (Intel)
    h264_vaapi   H.264 VAAPI GPU encode (AMD/Intel)
    hevc_vaapi   H.265 VAAPI GPU encode (AMD/Intel)
    av1          SVT-AV1 1080p, CRF 30, Opus 128k (smallest file)
    av14k        SVT-AV1 4K, CRF 32, Opus 128k (smallest 4K)
    av1_nvenc    AV1 NVENC GPU encode (NVIDIA RTX 40+)
    av1_amf      AV1 AMF GPU encode (AMD RX 7000+)
    av1_qsv      AV1 QSV GPU encode (Intel Arc)
    av1_vaapi    AV1 VAAPI GPU encode (AMD/Intel)
    prores       ProRes 422 HQ .mov (for further editing)
    webm         VP9 1080p, CRF 30, Opus 128k (web embedding)
    archive      H.264, CRF 15, FLAC audio (near-lossless archive)
    custom       Use -cv and -ca to specify codecs manually

  ${BOLD}OPTIONS${RESET}
    -p PRESET    Delivery preset (default: youtube)
    -o DIR       Output directory (default: same as input)
    -r RES       Force output resolution: 480p|720p|1080p|1440p|4k|original
                   (default: original — no scaling)
    -C N         Override CRF value (overrides preset default)
    -A CODEC     Override audio codec for ANY preset (e.g. -A flac, -A aac, -A pcm_s24le, -A libopus)
    -cv CODEC    Custom video codec (with -p custom)
    -ca CODEC    Custom audio codec (with -p custom)
    -j N         Parallel jobs (default: 1, requires GNU parallel)
    -n           Dry-run — show command without executing
    -h           Show this help

  ${BOLD}EXAMPLES${RESET}
    $0 export.mov                          # Default YouTube preset
    $0 -p h265 export.mov                  # H.265 smaller file
    $0 -p nvenc export.mov                 # NVENC GPU encode (fast)
    $0 -p av1 export.mov                  # AV1 smallest file
    $0 -p archive -o ~/archived/ *.mov    # Archive all exports
    $0 -p youtube -r 1080p export.mov     # Force 1080p output
    $0 -p youtube -r 720p big.mov          # Downscale to 720p
    $0 -p custom -cv libx264 -C 20 f.mov  # Custom H.264 CRF 20
    $0 -p youtube -C 20 export.mov        # YouTube with CRF 20 override
    $0 -p youtube -A flac export.mov      # YouTube H.264 but FLAC audio
    $0 -p nvenc -A pcm_s24le export.mov   # NVENC H.264 but PCM lossless audio
    $0 -p youtube -j 4 ~/exports/         # Parallel batch
EOF
exit 0
}

# ── Resolution scaling args ───────────────────────────────────────────────────
get_scale_args() {
  case "$1" in
    480p)  echo "-vf scale=854:480:force_original_aspect_ratio=decrease,pad=854:480:(ow-iw)/2:(oh-ih)/2" ;;
    720p)  echo "-vf scale=1280:720:force_original_aspect_ratio=decrease,pad=1280:720:(ow-iw)/2:(oh-ih)/2" ;;
    1080p) echo "-vf scale=1920:1080:force_original_aspect_ratio=decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2" ;;
    1440p) echo "-vf scale=2560:1440:force_original_aspect_ratio=decrease,pad=2560:1440:(ow-iw)/2:(oh-ih)/2" ;;
    4k)    echo "-vf scale=3840:2160:force_original_aspect_ratio=decrease,pad=3840:2160:(ow-iw)/2:(oh-ih)/2" ;;
    ""|original) echo "" ;;
  esac
}

# ── Preset definitions ────────────────────────────────────────────────────────
# Format: video_codec|video_args|audio_codec|audio_args|container
get_preset_args() {
  case "$1" in
    youtube)
      echo "libx264|-crf 18 -preset slow -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    youtube4k)
      echo "libx264|-crf 20 -preset slow -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    h265)
      echo "libx265|-crf 22 -preset medium -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    h2654k)
      echo "libx265|-crf 24 -preset medium -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    nvenc)
      echo "h264_nvenc|-preset p6 -tune hq -rc vbr -cq 20 -b:a 0 -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    nvenc265)
      echo "hevc_nvenc|-preset p6 -tune hq -rc vbr -cq 24 -b:a 0 -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    h264_amf)
      echo "h264_amf|-preset quality -rc cqp -qp_i 20 -qp_p 20 -qp_b 20 -b:a 0 -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    hevc_amf)
      echo "hevc_amf|-preset quality -rc cqp -qp_i 22 -qp_p 22 -qp_b 22 -b:a 0 -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    h264_qsv)
      echo "h264_qsv|-preset medium -global_quality 20 -look_ahead 0 -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    hevc_qsv)
      echo "hevc_qsv|-preset medium -global_quality 22 -look_ahead 0 -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    h264_vaapi)
      echo "h264_vaapi|-qp 20 -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    hevc_vaapi)
      echo "hevc_vaapi|-qp 22 -pix_fmt yuv420p -movflags +faststart|aac|-b:a 192k -ar 48000|mp4"
      ;;
    av1_nvenc)
      echo "av1_nvenc|-preset p6 -tune hq -rc vbr -cq 26 -b:a 0 -pix_fmt yuv420p -movflags +faststart|libopus|-b:a 128k -ar 48000|mp4"
      ;;
    av1_amf)
      echo "av1_amf|-preset quality -rc cqp -qp_i 26 -qp_p 26 -qp_b 26 -b:a 0 -pix_fmt yuv420p -movflags +faststart|libopus|-b:a 128k -ar 48000|mp4"
      ;;
    av1_qsv)
      echo "av1_qsv|-preset medium -global_quality 26 -look_ahead 0 -pix_fmt yuv420p -movflags +faststart|libopus|-b:a 128k -ar 48000|mp4"
      ;;
    av1_vaapi)
      echo "av1_vaapi|-qp 26 -pix_fmt yuv420p -movflags +faststart|libopus|-b:a 128k -ar 48000|mp4"
      ;;
    prores)
      echo "prores_ks|-profile:v 3 -pix_fmt yuv422p10le|pcm_s24le|-ar 48000|mov"
      ;;
    webm)
      echo "libvpx-vp9|-crf 30 -b:v 0 -pix_fmt yuv420p|libopus|-b:a 128k -ar 48000|webm"
      ;;
    archive)
      echo "libx264|-crf 15 -preset slow -pix_fmt yuv420p -movflags +faststart|flac|-ar 48000|mkv"
      ;;
    av1)
      echo "libsvtav1|-crf 30 -preset 6 -pix_fmt yuv420p -movflags +faststart|libopus|-b:a 128k -ar 48000|mp4"
      ;;
    av14k)
      echo "libsvtav1|-crf 32 -preset 6 -pix_fmt yuv420p -movflags +faststart|libopus|-b:a 128k -ar 48000|mp4"
      ;;
    custom)
      local v="${CUSTOM_VCODEC:-libx264}"
      local a="${CUSTOM_ACODEC:-aac}"
      local crf="${CRF_OVERRIDE:-18}"
      echo "${v}|-crf ${crf} -pix_fmt yuv420p -movflags +faststart|${a}|-b:a 192k -ar 48000|mp4"
      ;;
    *)
      error "Unknown preset: $1"
      exit 1
      ;;
  esac
}

# ── Process a single file ─────────────────────────────────────────────────────
process_file() {
  local input="$1"
  local preset_args output_ext
  preset_args=$(get_preset_args "$PRESET")
  IFS='|' read -r vcodec vparams acodec aparams output_ext <<< "$preset_args"

  # Apply CRF override if specified (replace any -crf N in vparams)
  if [[ -n "$CRF_OVERRIDE" && "$PRESET" != "custom" ]]; then
    vparams=$(echo "$vparams" | sed "s/-crf [0-9]*/-crf $CRF_OVERRIDE/")
  fi

  # Apply audio override if specified (replaces preset audio codec + params)
  if [[ -n "$AUDIO_OVERRIDE" ]]; then
    acodec="$AUDIO_OVERRIDE"
    # Set sensible default params per audio codec
    case "$AUDIO_OVERRIDE" in
      aac)         aparams="-b:a 192k -ar 48000" ;;
      pcm_s24le)   aparams="-ar 48000" ;;
      pcm_s16le)   aparams="-ar 48000" ;;
      flac)        aparams="-ar 48000" ;;
      alac)        aparams="-ar 48000" ;;
      libopus)     aparams="-b:a 128k -ar 48000" ;;
      libmp3lame)  aparams="-b:a 320k -ar 48000" ;;
      *)           aparams="-ar 48000" ;;
    esac
  fi

  # Build scale args
  local scale_args=""
  if [[ -n "$RESOLUTION" && "$RESOLUTION" != "original" ]]; then
    scale_args=$(get_scale_args "$RESOLUTION")
  fi

  local base="${input%.*}"
  local out_dir
  if [[ -n "$OUTPUT_DIR" ]]; then
    out_dir="$OUTPUT_DIR"
    mkdir -p "$out_dir"
  else
    out_dir="$(dirname "$input")"
  fi

  local out_file="${out_dir}/$(basename "$base").delivery.${output_ext}"

  if [[ -f "$out_file" ]]; then
    warn "Output file already exists, skipping: $out_file"
    return 0
  fi

  if $DRY_RUN; then
    echo "  ffmpeg -i \"$input\" $scale_args -c:v $vcodec $vparams -c:a $acodec $aparams \"$out_file\""
    return 0
  fi

  local ffmpeg_cmd=(ffmpeg -hide_banner -loglevel error -stats -i "$input")

  # Add scale filter if specified
  if [[ -n "$scale_args" ]]; then
    ffmpeg_cmd+=($scale_args)
  fi

  ffmpeg_cmd+=(-map 0:v:0 -map '0:a?' -c:v "$vcodec" $vparams -c:a "$acodec" $aparams -y "$out_file")

  if "${ffmpeg_cmd[@]}" 2>&1; then
    local in_size out_size
    in_size=$(du -h "$input" 2>/dev/null | cut -f1 || echo "?")
    out_size=$(du -h "$out_file" 2>/dev/null | cut -f1 || echo "?")
    success "$(basename "$out_file")  ($in_size → $out_size)"
    return 0
  else
    error "Failed: $input"
    rm -f "$out_file"
    return 1
  fi
}

# ── Main ──────────────────────────────────────────────────────────────────────
while getopts ":p:o:r:C:A:cv:ca:j:nh" opt; do
  case $opt in
    p) PRESET="$OPTARG" ;;
    o) OUTPUT_DIR="$OPTARG" ;;
    r) RESOLUTION="$OPTARG" ;;
    C) CRF_OVERRIDE="$OPTARG" ;;
    A) AUDIO_OVERRIDE="$OPTARG" ;;
    cv) CUSTOM_VCODEC="$OPTARG" ;;
    ca) CUSTOM_ACODEC="$OPTARG" ;;
    j) PARALLEL_JOBS="$OPTARG" ;;
    n) DRY_RUN=true ;;
    h) usage ;;
    :) error "Option -$OPTARG requires an argument."; exit 1 ;;
    \?) error "Unknown option: -$OPTARG"; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -eq 0 ]]; then
  error "No input files specified. Use -h for help."
  exit 2
fi

command -v ffmpeg &>/dev/null || { error "ffmpeg not found"; exit 1; }
command -v ffprobe &>/dev/null || { error "ffprobe not found"; exit 1; }

# Validate preset (custom is always valid, others must match)
if [[ "$PRESET" != "custom" ]]; then
  get_preset_args "$PRESET" &>/dev/null || exit 1
fi

# Check encoder availability
_enc_list="$(ffmpeg -hide_banner -encoders 2>&1 || true)"
AVAILABLE_ENCODERS=""
for enc in h264_nvenc hevc_nvenc av1_nvenc h264_amf hevc_amf av1_amf h264_qsv hevc_qsv av1_qsv h264_vaapi hevc_vaapi av1_vaapi libsvtav1; do
  if echo "$_enc_list" | grep -qE "[[:space:]]+${enc}[[:space:]]+"; then
    AVAILABLE_ENCODERS="$AVAILABLE_ENCODERS $enc"
  fi
done

# If using a specific hardware encoder preset, verify it is available
check_hardware_encoder() {
  local preset="$1"
  local required_enc=""
  case "$preset" in
    nvenc)      required_enc="h264_nvenc" ;;
    nvenc265)   required_enc="hevc_nvenc" ;;
    av1_nvenc)  required_enc="av1_nvenc" ;;
    h264_amf)   required_enc="h264_amf" ;;
    hevc_amf)   required_enc="hevc_amf" ;;
    av1_amf)    required_enc="av1_amf" ;;
    h264_qsv)   required_enc="h264_qsv" ;;
    hevc_qsv)   required_enc="hevc_qsv" ;;
    av1_qsv)    required_enc="av1_qsv" ;;
    h264_vaapi) required_enc="h264_vaapi" ;;
    hevc_vaapi) required_enc="hevc_vaapi" ;;
    av1_vaapi)  required_enc="av1_vaapi" ;;
    av1|av14k)  required_enc="libsvtav1" ;;
  esac

  if [[ -n "$required_enc" ]]; then
    if ! echo "$AVAILABLE_ENCODERS" | grep -q "$required_enc"; then
      error "Encoder '$required_enc' for preset '$preset' is not available in system ffmpeg."
      exit 1
    fi
  fi
}
check_hardware_encoder "$PRESET"

# Expand directory arguments into files
FILES=()
for arg in "$@"; do
  if [[ -d "$arg" ]]; then
    while IFS= read -r -d '' f; do
      FILES+=("$f")
    done < <(find "$arg" -maxdepth 1 -type f \( \
      -iname "*.mov" -o -iname "*.mkv" -o -iname "*.mp4" -o -iname "*.avi" \
      -o -iname "*.mxf" -o -iname "*.webm" -o -iname "*.ts" -o -iname "*.m2ts" \
      -o -iname "*.mts" -o -iname "*.wmv" -o -iname "*.flv" -o -iname "*.mpg" \
      -o -iname "*.mpeg" -o -iname "*.m4v" -o -iname "*.3gp" -o -iname "*.ogv" \
      \) -print0 | sort -z)
  else
    FILES+=("$arg")
  fi
done

# Export for parallel
export -f process_file get_preset_args get_scale_args info success warn error
export PRESET OUTPUT_DIR DRY_RUN RESOLUTION CUSTOM_VCODEC CUSTOM_ACODEC CRF_OVERRIDE AUDIO_OVERRIDE

ok=0 fail=0
if [[ "$PARALLEL_JOBS" -gt 1 ]] && command -v parallel &>/dev/null; then
  joblog=$(mktemp)
  printf '%s\n' "${FILES[@]}" \
    | parallel -j "$PARALLEL_JOBS" --joblog "$joblog" process_file {}
  ok=$(awk 'NR>1 && $7==0' "$joblog" 2>/dev/null | wc -l)
  fail=$(awk 'NR>1 && $7!=0' "$joblog" 2>/dev/null | wc -l)
  rm -f "$joblog"
else
  [[ "$PARALLEL_JOBS" -gt 1 ]] && warn "GNU parallel not found — running sequentially"
  for f in "${FILES[@]}"; do
    if process_file "$f"; then
      ((ok++))
    else
      ((fail++))
    fi
  done
fi

echo
success "Done: $ok converted, $fail failed"