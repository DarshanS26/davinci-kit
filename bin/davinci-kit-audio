#!/usr/bin/env bash
# =============================================================================
#  davinci-kit-audio — Batch convert audio files for DaVinci Resolve on Linux
#
#  Converts unsupported audio formats (AAC, M4A, Opus, OGG, WMA, AC3, DTS, etc.)
#  into Resolve-compatible formats: PCM WAV 24-bit 48kHz, FLAC, ALAC, or MP3.
#
#  Usage:
#    davinci-kit-audio [OPTIONS] <file|dir ...>
# =============================================================================

set -euo pipefail

FORMAT="wav"
OUTPUT_DIR=""
PARALLEL_JOBS=1
DRY_RUN=false
SAMPLE_RATE="48000"
CHANNELS="2"

# ── Colour helpers ────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
  CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; RESET=''
fi

info()    { echo -e "${CYAN}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error()   { echo -e "${RED}[ERR]${RESET}   $*" >&2; }

usage() {
cat <<EOF
${BOLD}davinci-kit-audio${RESET} — Convert audio files for DaVinci Resolve on Linux

  ${BOLD}USAGE${RESET}
    $0 [OPTIONS] <file> [file ...]       # Convert specific audio files
    $0 [OPTIONS] <directory>              # Convert all audio in directory

  ${BOLD}OPTIONS${RESET}
    -f FORMAT   Output audio format:
                  wav  = 24-bit 48kHz PCM WAV (Universal Resolve support) [DEFAULT]
                  flac = 24-bit 48kHz FLAC (Lossless, 50% smaller)
                  alac = Apple Lossless M4A
                  mp3  = 320 kbps MP3 (Lossy, compact)
    -o DIR      Custom output directory (default: <INPUT_DIR>/resolve_audio)
    -r RATE     Sample rate in Hz (default: 48000)
    -c CHANS    Channels (default: 2 for stereo, 1 for mono)
    -j N        Parallel conversion jobs (default: 1, requires GNU parallel)
    -n          Dry-run preview (show command without running)
    -h          Show this help

  ${BOLD}SUPPORTED INPUT FORMATS${RESET}
    AAC, M4A, MP3, Opus, OGG/OGA, FLAC, WAV, AIFF/AIF, WMA, APE, ALAC,
    AC3, DTS, DTS-HD, E-AC3, AMR, CAF, Speex, TTA, WavPack, Musepack,
    MKA, RA, AU, MIDI, TrueHD, MLP

  ${BOLD}EXAMPLES${RESET}
    $0 music.m4a voiceover.aac
    $0 -f flac /path/to/audio/
    $0 -f wav -o ~/resolve_sound/ audio.opus
    $0 -f flac -j 4 /path/to/audio/          # Parallel processing
EOF
exit 0
}

while getopts ":f:o:r:c:j:nh" opt; do
  case $opt in
    f) FORMAT="$OPTARG" ;;
    o) OUTPUT_DIR="$OPTARG" ;;
    r) SAMPLE_RATE="$OPTARG" ;;
    c) CHANNELS="$OPTARG" ;;
    j) PARALLEL_JOBS="$OPTARG" ;;
    n) DRY_RUN=true ;;
    h) usage ;;
    :) error "Option -$OPTARG requires an argument."; exit 1 ;;
    \?) error "Unknown option: -$OPTARG"; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -eq 0 ]]; then
  usage
fi

case "$FORMAT" in
  wav|flac|alac|mp3) ;;
  *) error "Invalid format: $FORMAT. Choose wav|flac|alac|mp3"; exit 1 ;;
esac

# ── Comprehensive audio extension list ────────────────────────────────────────
AUDIO_FIND_ARGS=(
  -iname "*.aac" -o -iname "*.m4a" -o -iname "*.mp3" -o -iname "*.opus"
  -o -iname "*.ogg" -o -iname "*.oga" -o -iname "*.flac" -o -iname "*.wma"
  -o -iname "*.aiff" -o -iname "*.aif" -o -iname "*.wav" -o -iname "*.ape"
  -o -iname "*.alac" -o -iname "*.ac3" -o -iname "*.dts" -o -iname "*.dtshd"
  -o -iname "*.eac3" -o -iname "*.amr" -o -iname "*.caf" -o -iname "*.spx"
  -o -iname "*.tta" -o -iname "*.wv" -o -iname "*.mpc" -o -iname "*.mka"
  -o -iname "*.ra" -o -iname "*.au" -o -iname "*.mid" -o -iname "*.midi"
  -o -iname "*.truehd" -o -iname "*.mlp"
)

# Collect input files
INPUT_FILES=()
for arg in "$@"; do
  if [[ -f "$arg" ]]; then
    INPUT_FILES+=("$(realpath "$arg")")
  elif [[ -d "$arg" ]]; then
    while IFS= read -r -d '' f; do
      INPUT_FILES+=("$f")
    done < <(find "$(realpath "$arg")" -type f \( "${AUDIO_FIND_ARGS[@]}" \) -print0)
  else
    warn "Skipping non-existent path: $arg"
  fi
done

if [[ ${#INPUT_FILES[@]} -eq 0 ]]; then
  error "No valid audio files found."
  exit 1
fi

SEARCH_DIR="$(dirname "${INPUT_FILES[0]}")"
if [[ -z "$OUTPUT_DIR" ]]; then
  OUTPUT_DIR="${SEARCH_DIR}/resolve_audio"
fi
mkdir -p "$OUTPUT_DIR"

ext="$FORMAT"
[[ "$FORMAT" == "alac" ]] && ext="m4a"

convert_file() {
  local input="$1"
  local base
  base="$(basename "${input%.*}")"
  local output="${OUTPUT_DIR}/${base}.${ext}"

  if [[ -f "$output" ]]; then
    warn "Skipping (exists): $output"
    return 0
  fi

  local ffmpeg_args=()
  case "$FORMAT" in
    wav)  ffmpeg_args=("-c:a" "pcm_s24le" "-ar" "$SAMPLE_RATE" "-ac" "$CHANNELS") ;;
    flac) ffmpeg_args=("-c:a" "flac" "-ar" "$SAMPLE_RATE" "-ac" "$CHANNELS") ;;
    alac) ffmpeg_args=("-c:a" "alac" "-ar" "$SAMPLE_RATE" "-ac" "$CHANNELS") ;;
    mp3)  ffmpeg_args=("-c:a" "libmp3lame" "-b:a" "320k" "-ar" "$SAMPLE_RATE" "-ac" "$CHANNELS") ;;
  esac

  info "AUDIO $(basename "$input") → $(basename "$output") [${FORMAT^^}]"

  if $DRY_RUN; then
    echo "       ffmpeg -i \"$input\" ${ffmpeg_args[*]} \"$output\""
    return 0
  fi

  if ffmpeg -hide_banner -loglevel error -stats -i "$input" "${ffmpeg_args[@]}" -y "$output" 2>&1; then
    success "Done: $(basename "$output")"
  else
    error "Failed: $(basename "$input")"
    rm -f "$output"
    return 1
  fi
}

export -f convert_file info success warn error
export OUTPUT_DIR FORMAT ext SAMPLE_RATE CHANNELS DRY_RUN

ok=0 fail=0
if [[ "$PARALLEL_JOBS" -gt 1 ]] && command -v parallel &>/dev/null; then
  joblog=$(mktemp)
  printf '%s\n' "${INPUT_FILES[@]}" \
    | parallel -j "$PARALLEL_JOBS" --joblog "$joblog" convert_file {}
  ok=$(awk 'NR>1 && $7==0' "$joblog" 2>/dev/null | wc -l)
  fail=$(awk 'NR>1 && $7!=0' "$joblog" 2>/dev/null | wc -l)
  rm -f "$joblog"
else
  [[ "$PARALLEL_JOBS" -gt 1 ]] && warn "GNU parallel not found — running sequentially"
  for file in "${INPUT_FILES[@]}"; do
    if convert_file "$file"; then
      ((ok++))
    else
      ((fail++))
    fi
  done
fi

echo
success "Done: $ok converted, $fail failed"